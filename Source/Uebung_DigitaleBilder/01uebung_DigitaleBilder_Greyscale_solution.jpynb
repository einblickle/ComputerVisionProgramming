   "source": [
    "# Bildausschnitt / ROI wird festgelegt\n",
    "imageLighthouse_ROI = imageLighthouse[100:300, 200:400]\n",
    "\n",
    "# Anzeige des Bildes\n",
    "fig = px.imshow(imageLighthouse_ROI, color_continuous_scale='gray')\n",
    "fig.update_layout(\n",
    "    margin=dict(l=0, r=0, t=0, b=0),\n",
    "    width=500,\n",
    "    height=500\n",
    ")\n",
    "fig.show()"
   ]
  },
