    "##\n",
    "## ENTER CODE HERE\n",
    "##\n",
    "\n",
    "#imageButterfly_Red = \n",
    "#imageButterfly_Green =\n",
    "#imageButterfly_Blue =\n",
    "\n",
    "\n",
    "# Anzeige der Bilder\n",
    "\n",
    "# Roter Farbkanal\n",
    "fig = px.imshow(imageButterfly_Red, color_continuous_scale='gray', title='Roter Farbkanal')\n",
    "fig.update_layout(\n",
    "    margin=dict(l=0, r=0, t=50, b=0),\n",
    "    width=500,\n",
    "    height=500\n",
    ")\n",
    "fig.show()\n",
    "\n",
    "## Gruenes Farbkanal\n",
    "fig = px.imshow(imageButterfly_Green, color_continuous_scale='gray', title='Gruener Farbkanal')\n",
    "fig.update_layout(\n",
    "    margin=dict(l=0, r=0, t=50, b=0),\n",
    "    width=500,\n",
    "    height=500\n",
    ")\n",
    "fig.show()\n",
    "\n",
    "# Blauer Farbkanal\n",
    "fig = px.imshow(imageButterfly_Blue, color_continuous_scale='gray', title='Blauer Farbkanal')\n",
    "fig.update_layout(\n",
    "    margin=dict(l=0, r=0, t=50, b=0),\n",
    "    width=500,\n",
    "    height=500\n",
    ")\n",
    "fig.show()"
   ]
